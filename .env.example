# WebTranslatorr Configuration

# ──────────────────────────────────────────────────────────────
# IMPORTANT: Configuration can now be managed via the web UI!
# Navigate to http://localhost:9811/ in your browser after
# starting the server to manage providers, API keys, and
# Readarr integration without editing this file.
#
# The .env file is still used for initial setup. On first run,
# all settings are migrated to SQLite (data/webtranslatorr.db).
# Subsequent changes via the web UI persist in the database.
# ──────────────────────────────────────────────────────────────

# Environment: development | production
# In production, WTR_API_KEY must be set to a secure value (not "changeme")
WTR_ENV=development

# Server settings
WTR_HOST=0.0.0.0
WTR_PORT=9811
# Coloca aquí una clave segura para conectar tus *Arr a este Proxy
WTR_API_KEY=my_super_secret_api_key_here
WTR_LOG_LEVEL=INFO
# URL externa visible por las apps *Arr (si se deja vacía usa http://{HOST}:{PORT})
WTR_EXTERNAL_URL=http://localhost:9811

# Provider enable/disable
WTR_EBOOKELO_ENABLED=true
WTR_EPUBLIBRE_ENABLED=true
WTR_LECTULANDIA_ENABLED=true
WTR_ESPAEBOOK_ENABLED=true
WTR_HOLAEBOOK_ENABLED=true
WTR_ELEJANDRIA_ENABLED=false
WTR_ANNASARCHIVE_ENABLED=true
WTR_GUTENBERG_ENABLED=false
WTR_MEJORTORRENT_ENABLED=true
WTR_DONTORRENT_ENABLED=false

# New provider enable/disable
WTR_EPUBFLIX1_ENABLED=true
WTR_LIBGEN_ENABLED=true
WTR_BOOOBOOK_ENABLED=true
WTR_LECTUEPUBLIBRE5_ENABLED=true
WTR_MUNDOEPUBLIBRE1_ENABLED=true
WTR_ZLIBRARY_ENABLED=true

# Integration plan — new book providers
WTR_EPUBGRATIS_ENABLED=true
WTR_EBIBLIOTECA_ENABLED=true
WTR_BAJAEEBOOKS_ENABLED=true
WTR_LELIBROS_ENABLED=true

# Integration plan — new video/torrent providers (unstable domains, disabled by default)
WTR_DIVXTOTAL_ENABLED=false
WTR_ELITETORRENT_ENABLED=false

# Provider domains (update if domains change)
WTR_MEJORTORRENT_DOMAIN=https://www42.mejortorrent.eu
WTR_DONTORRENT_DOMAIN=https://dontorrent.reisen
WTR_EBOOKELO_DOMAIN=https://ww2.ebookelo.com
WTR_EPUBLIBRE_DOMAIN=https://epublibre.bid
WTR_LECTULANDIA_DOMAIN=https://ww3.lectulandia.co
WTR_ESPAEBOOK_DOMAIN=https://espaebook.cc
WTR_HOLAEBOOK_DOMAIN=https://holaebook.com
WTR_ELEJANDRIA_DOMAIN=https://www.elejandria.com
WTR_ANNASARCHIVE_DOMAIN=https://annas-archive.gl
WTR_GUTENBERG_DOMAIN=https://gutenberg.org
# New provider domains
WTR_EPUBFLIX1_DOMAIN=https://epubflix1.com
WTR_LIBGEN_DOMAIN=https://libgen.ee
WTR_BOOOBOOK_DOMAIN=https://es.booobook.bond
WTR_LECTUEPUBLIBRE5_DOMAIN=https://lectuepublibre5.com
WTR_MUNDOEPUBLIBRE1_DOMAIN=https://mundoepublibre1.com
WTR_ZLIBRARY_DOMAIN=https://z-library.sk
# Integration plan — new provider domains
WTR_EPUBGRATIS_DOMAIN=https://www.epubgratis.org
WTR_EBIBLIOTECA_DOMAIN=https://ebiblioteca.org
WTR_BAJAEEBOOKS_DOMAIN=https://bajaebooks.info
WTR_LELIBROS_DOMAIN=https://lelibros.online
WTR_DIVXTOTAL_DOMAIN=https://divxtotal.wtf
WTR_ELITETORRENT_DOMAIN=https://www.elitetorrent.com
# Plan 003 — new book providers
WTR_BOOKSEE_ENABLED=true
WTR_BOOKSEE_DOMAIN=https://en.booksee.org
WTR_OCEANOFPDF_ENABLED=true
WTR_OCEANOFPDF_DOMAIN=https://oceanofpdf.com

# TMDB API (optional, for IMDb ID resolution)
# Get your free API key at: https://www.themoviedb.org/settings/api
WTR_TMDB_API_KEY=

# Scraping settings
WTR_RATE_LIMIT_PER_SECOND=2.0
WTR_MAX_RETRIES=3
WTR_REQUEST_TIMEOUT=30

# FlareSolverr — bypass Cloudflare Turnstile (servicio externo)
# Dejar vacío para deshabilitar. Ejemplo: http://192.168.0.102:8191
WTR_FLARESOLVERR_URL=

# Torrent Blackhole watcher — monitors a directory for .torrent files
# dropped by Readarr and downloads the actual books via webseed.
# Requires a shared volume between Readarr and WebTranslatorr.
# Set both to empty to disable.
WTR_BLACKHOLE_DIR=
WTR_BLACKHOLE_OUTPUT_DIR=

# Cache settings
WTR_CACHE_ENABLED=true
WTR_CACHE_TTL_SECONDS=300

# Domain auto-resolution
WTR_DOMAIN_CHECK_INTERVAL=1800
WTR_DOMAIN_VALIDATION_TIMEOUT=10

# Translation Pipeline (book-title translation via Wikidata + Google Books)
# Requires: WTR_TRANSLATION_PIPELINE_SEARCH_ENABLED=true to activate
# Wikidata phase is free (no API key). Google Books phase is optional.
WTR_TRANSLATION_PIPELINE_SEARCH_ENABLED=false
WTR_TRANSLATION_PIPELINE_WIKIDATA_ENABLED=true
WTR_TRANSLATION_PIPELINE_GOOGLE_BOOKS_ENABLED=true
WTR_GOOGLE_BOOKS_API_KEY=
WTR_TRANSLATION_PIPELINE_TIMEOUT=10

# Default target language for translation lookups (ISO 639-1 code).
# Supported: es, en, fr, de, it, pt.
# Can be overridden per-request via ?lang= parameter on *Arr endpoints.
WTR_DEFAULT_SEARCH_LANGUAGE=es

# Proxy (optional)
WTR_HTTP_PROXY=
